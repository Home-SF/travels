rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Trips and all sub-collections are publicly readable.
    // Writes require authentication (admin only via Firebase Console or seed scripts).
    match /trips/{tripId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{subcollection}/{docId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Photos sub-collection: public read, authenticated write
    match /photos/{photoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // City restaurant guides — independent of any trip
    match /cityRestaurants/{citySlug}/restaurants/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
